--- !u!114 &7960242224818419537
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4967251085725756725}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c3edfa315ce66cd40a0e4a9097e415c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  manager: {fileID: 1864558201}
  art: {fileID: 21300000, guid: 43ad4fc5437a2f3479e80e6543827265, type: 3}
  artName: Whale 1
  artistName: Julia Upiterskaya
  artDetails: "This artwork is a surreal dreamscape where a colossal blue whale drifts
    above Rio de Janeiro\u2019s glowing shoreline, merging the vastness of the ocean
    with the infinite sky. The city\u2019s golden lights pulse with human energy
    beneath the serene gaze of Christ the Redeemer, while a whale-shaped constellation
    mirrors the giant presence above, suggesting a cosmic connection between earth,
    sea, and stars. Through bold contrasts of deep blues, purples, and radiant yellows,
    the piece evokes wonder, humility, and the reminder that humanity is but a small
    flicker within the grandeur of nature and the universe."
  artistDetails: "Julia Upiterskaya is a Dubai-based entrepreneur, creative visionary,
    and founder of the communications agency JULS. She is active in media, Web3,
    and AI spaces, and also hosts the podcast \u201CRevelations.\u201D With a background
    from Volgograd State University, Julia has built a strong presence in the Middle
    East as a speaker, content creator, and artist, blending creativity, technology,
    and storytelling through projects such as her art series \u201C7 Waves of Whales.\u201D"
  instaID: upiterskayaj
  portfolioLink: https://t.me/upiterskayajulia
